{
  "name": "cary-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "data:snapshot": "node pipeline/scripts/snapshot.mjs",
    "data:build": "node pipeline/scripts/build-catalog.mjs",
    "data:publish": "node pipeline/scripts/publish.mjs",
    "data:refresh": "node pipeline/scripts/refresh.mjs",
    "check:budgets": "node pipeline/scripts/check-budgets.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "fuse.js": "^7.5.0",
    "ol": "^10.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
